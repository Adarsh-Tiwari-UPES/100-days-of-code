//Q109: Write a program to take an integer array arr and an integer k as inputs. Print the maximum sum of all the subarrays of size k.

/*
Sample Test Cases:
Input 1:
4
100 200 300 400
2
Output 1:
700

Input 2:
9Q109: Write a program to take an integer array arr and an integer k as inputs.
1 4 2 10 23 3 1 0 20
4
Output 2:
39

*/

#include <stdio.h>

int main() {
    int n;
    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }
    int arr[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    int k;
    if (scanf("%d", &k) != 1 || k <= 0 || k > n) {
        return 1;
    }
    int window_sum = 0;
    for (int i = 0; i < k; i++) {
        window_sum += arr[i];
    }
    int max_sum = window_sum;
    for (int i = k; i < n; i++) {
        window_sum += arr[i] - arr[i - k];
        if (window_sum > max_sum) {
            max_sum = window_sum;
        }
    }
    printf("%d\n", max_sum);
    return 0;
}
