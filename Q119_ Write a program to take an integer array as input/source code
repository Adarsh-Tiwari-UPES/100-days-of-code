//Q119: Write a program to take an integer array as input. Only one element will be repeated. Print the repeated element. Try to find the result in one single iteration.

/*
Sample Test Cases:
Input 1:
4
1 3 3 4
Output 1:
3

Input 2:
3
1 2 2
Output 2:
2

*/

#include <stdio.h>

int main() {
    int n;
    if (scanf("%d", &n) != 1 || n <= 1) {
        return 1;
    }
    int arr[n];
    int visited[100005] = {0};
    int repeated = -1;
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        if (arr[i] >= 0 && arr[i] < 100005) {
            if (visited[arr[i]] == 1) {
                repeated = arr[i];
            }
            visited[arr[i]] = 1;
        }
    }
    printf("%d\n", repeated);
    return 0;
}
