//Q92: Find the first repeating lowercase alphabet in a string.

/*
Sample Test Cases:
Input 1:
stress
Output 1:
s

*/

#include <stdio.h>

int main() {
    char str[1000];
    if (fgets(str, sizeof(str), stdin) == NULL) {
        return 1;
    }
    int seen[26] = {0};
    char repeating = '\0';
    for (int i = 0; str[i] != '\0' && str[i] != '\n'; i++) {
        char ch = str[i];
        if (ch >= 'a' && ch <= 'z') {
            if (seen[ch - 'a'] == 1) {
                repeating = ch;
                break;
            }
            seen[ch - 'a'] = 1;
        }
    }
    if (repeating != '\0') {
        printf("%c\n", repeating);
    } else {
        printf("-1\n");
    }
    return 0;
}
