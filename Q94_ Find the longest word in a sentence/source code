//Q94: Find the longest word in a sentence.

/*
Sample Test Cases:
Input 1:
I love programming
Output 1:
programming

*/

#include <stdio.h>
#include <string.h>

int main() {
    char str[1000];
    if (fgets(str, sizeof(str), stdin) == NULL) {
        return 1;
    }
    str[strcspn(str, "\n")] = '\0';

    int max_len = 0, curr_len = 0;
    int max_start = 0, curr_start = 0;

    for (int i = 0; ; i++) {
        if (str[i] == ' ' || str[i] == '\0') {
            if (curr_len > max_len) {
                max_len = curr_len;
                max_start = curr_start;
            }
            curr_len = 0;
            curr_start = i + 1;
            if (str[i] == '\0') {
                break;
            }
        } else {
            curr_len++;
        }
    }

    for (int i = 0; i < max_len; i++) {
        printf("%c", str[max_start + i]);
    }
    printf("\n");
    return 0;
}
