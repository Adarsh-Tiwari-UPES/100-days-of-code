//Q97: Print the initials of a name.

/*
Sample Test Cases:
Input 1:
John Doe
Output 1:
J.D.

*/

#include <stdio.h>
#include <string.h>

int main() {
    char str[1000];
    if (fgets(str, sizeof(str), stdin) == NULL) {
        return 1;
    }
    str[strcspn(str, "\n")] = '\0';

    for (int i = 0; str[i] != '\0'; i++) {
        if ((i == 0 || str[i - 1] == ' ') && str[i] != ' ') {
            char ch = str[i];
            if (ch >= 'a' && ch <= 'z') {
                ch -= 32;
            }
            printf("%c.", ch);
        }
    }
    printf("\n");
    return 0;
}
