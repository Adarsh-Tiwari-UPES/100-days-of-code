//Q98: Print initials of a name with the surname displayed in full.

/*
Sample Test Cases:
Input 1:
John David Doe
Output 1:
J.D. Doe

*/

#include <stdio.h>
#include <string.h>

int main() {
    char str[1000];
    if (fgets(str, sizeof(str), stdin) == NULL) {
        return 1;
    }
    str[strcspn(str, "\n")] = '\0';

    int len = strlen(str);
    while (len > 0 && str[len - 1] == ' ') {
        str[--len] = '\0';
    }

    int last_space = -1;
    for (int i = 0; i < len; i++) {
        if (str[i] == ' ') {
            last_space = i;
        }
    }

    for (int i = 0; i < last_space; i++) {
        if ((i == 0 || str[i - 1] == ' ') && str[i] != ' ') {
            char ch = str[i];
            if (ch >= 'a' && ch <= 'z') {
                ch -= 32;
            }
            printf("%c.", ch);
        }
    }

    if (last_space != -1) {
        printf(" %s\n", &str[last_space + 1]);
    } else {
        printf("%s\n", str);
    }
    return 0;
}
